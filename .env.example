# Copie para .env e ajuste os valores.
DATABASE_URL="file:./facmap.db"

# Gere uma chave forte, por exemplo:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="troque-esta-chave"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
