# Copie para .env e ajuste os valores. Em produção, cadastre as mesmas variáveis no painel da hospedagem.

# Banco PostgreSQL (Supabase): no painel, botão "Connect" → "Transaction pooler" (porta 6543).
# O ?pgbouncer=true do tempo do Prisma pode ficar ou sair: o código remove esse parâmetro.
DATABASE_URL="postgresql://postgres.SEU_PROJETO:SENHA@aws-1-REGIAO.pooler.supabase.com:6543/postgres"

# Gere uma chave forte, por exemplo:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY="troque-esta-chave"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_MINUTES=1440

# Origens do frontend liberadas no CORS (separadas por vírgula), com https:// e sem barra no fim.
# Em produção, inclua a URL da Vercel: https://frontend-fac-map.vercel.app
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Opcional: regex para liberar também as URLs de preview da Vercel.
# CORS_ORIGIN_REGEX="https://frontend-fac-map-.*\.vercel\.app"
