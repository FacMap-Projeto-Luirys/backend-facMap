// Schema do banco de dados do FacMap (Prisma Client Python).
// Depois de alterar este arquivo, rode:  prisma db push   (ou prisma migrate dev)

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             Int          @id @default(autoincrement())
  name           String
  email          String       @unique
  hashedPassword String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assessments    Assessment[]

  @@map("users")
}

// Cada envio do formulário de avaliação.
// `answers` e `result` guardam JSON serializado em texto (SQLite não tem tipo JSON no Prisma 5).
model Assessment {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   String
  result    String
  topArea   String
  version   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("assessments")
}
